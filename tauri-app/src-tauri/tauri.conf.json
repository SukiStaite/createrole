{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "搭角色",
  "version": "1.0.0",
  "identifier": "com.sukistaite.createrole",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "搭角色 · 双子",
        "width": 480,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "withGlobalTauri": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
